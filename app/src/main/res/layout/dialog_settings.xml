<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Einstellungen"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Sensibilität -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensibilität (1=gering, 100=ultra)"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSensitivityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textColor="#4CAF50"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="20dp" />

        <!-- Videoqualität -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Videoqualität"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbSD"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SD"
                android:textColor="#FFFFFF"
                android:buttonTint="#4CAF50" />

            <RadioButton
                android:id="@+id/rbHD"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HD"
                android:textColor="#FFFFFF"
                android:buttonTint="#4CAF50" />

            <RadioButton
                android:id="@+id/rbFHD"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FHD"
                android:textColor="#FFFFFF"
                android:buttonTint="#4CAF50" />

        </RadioGroup>

        <!-- Ton -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ton aufnehmen"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mikrofon aktiv"
            android:textColor="#FFFFFF"
            android:thumbTint="#4CAF50"
            android:trackTint="#2E7D32"
            android:layout_marginBottom="20dp" />

        <!-- Pre-Buffer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pre-Buffer (Sekunden)"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPreBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="20"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="20dp" />

        <!-- Nachlaufzeit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nachlaufzeit nach Bewegung (Sek.)"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTrailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="30"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="20dp" />

        <!-- Max Videolänge -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max. Videolänge (Minuten)"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMaxVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="10"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="20dp" />

        <!-- Speicherpfad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speicherpfad"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSavePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movies/Wildkamera"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnChooseFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ordner wählen"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speichern"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>