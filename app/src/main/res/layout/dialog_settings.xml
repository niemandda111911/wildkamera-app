<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensitivity_label"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSensitivityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2%"
            android:textColor="#4CAF50"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="2"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pre_buffer_label"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPreBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="20"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trail_time_label"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTrailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="30"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/max_video_label"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMaxVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="10"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_path_label"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSavePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movies/Wildkamera"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnChooseFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_path_btn"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
